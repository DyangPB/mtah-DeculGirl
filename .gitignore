# --- Data pertandingan: TIDAK PERNAH DI-COMMIT ---------------------------------
# Bundle dilisensikan hanya untuk kompetisi ini. Menyebarkannya melanggar ToU.
data/
*.mp4

# --- Output: bisa direproduksi, jadi tidak perlu di-commit -------------------
# Yang dijanjikan bukan file-nya ada di repo, tapi repo-nya BISA menghasilkan
# file itu persis. Repo resmi juga mengabaikan CSV hasilnya.
#
# SEMUA .csv diabaikan, bukan cuma results/ -- ini pengaman ToU. Kalau kalian
# memang butuh meng-commit CSV kecil yang aman (mis. tabel referensi tanpa isi
# data pertandingan), paksa dengan:  git add -f namafile.csv
# dan tulis alasannya di docs/decisions.md.
results/
*.csv

# --- Repo resmi hasil fetch: diambil ulang oleh tools/fetch_official.py ------
# Di-pin ke commit tertentu, jadi tidak perlu disimpan.
third_party/

